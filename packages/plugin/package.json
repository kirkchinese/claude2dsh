{
  "name": "@claude2dsh/plugin",
  "version": "0.1.0-rc.2",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./hook-bridge": {
      "types": "./lib/hook-bridge.d.ts",
      "default": "./lib/hook-bridge.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@claude2dsh/adapter-claude-code": "workspace:^0.1.0-rc.2",
    "@claude2dsh/core": "workspace:^0.1.0-rc.2",
    "chokidar": "^5.0.0",
    "@deepseek-ai/dsh-hooks-claude-code": "0.1.0-rc.6",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.3"
  },
  "description": "Import Claude Code sessions and skills into DeepSeek Harness, and sync DSH sessions back to Claude Code",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claude2DSH/Claude2DSH.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "migration",
    "session",
    "skills"
  ]
}
